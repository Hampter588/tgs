# Copy to .env on your server. Never commit .env or real credentials.
PUBLIC_URL=https://tgs.example.com
DATABASE_PATH=data/tgs.sqlite
HOST=127.0.0.1
PORT=3001
TRUST_PROXY=1
# Comma-separated additional web origins (no wildcards).
ALLOWED_ORIGINS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=TGS <noreply@example.com>
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_ENTITLEMENT=tgs_plus
REVENUECAT_IOS_PUBLIC_KEY=
REVENUECAT_ANDROID_PUBLIC_KEY=
# Used by Docker Compose / Caddy for HTTPS.
TGS_DOMAIN=tgs.example.com
# Optional public endpoint baked into desktop/mobile builds; never a secret.
VITE_API_URL=
