{
  "name": "tgs",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "The Gathering Social — an ad-free community for Magic players",
  "author": "TGS",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "mobile:sync": "npm run build && cap sync",
    "test": "node --test server/tests/*.test.mjs",
    "test:api": "node --test server/tests/*.test.mjs",
    "test:e2e": "playwright test",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "server:dev": "node --env-file-if-exists=.env --watch server/index.mjs",
    "dev:full": "concurrently -k \"npm run server:dev\" \"npm run dev\"",
    "admin:create": "node --env-file-if-exists=.env server/admin.mjs",
    "db:backup": "node --env-file-if-exists=.env server/backup.mjs",
    "local": "npm run build && node scripts/local-server.mjs",
    "prepare:nix": "npm run build && node scripts/prepare-nix.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@revenuecat/purchases-capacitor": "^13.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.577.0",
    "nodemailer": "^10.0.14",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@playwright/test": "^1.58.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^10.0.5",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "vite": "^7.3.0",
    "vitest": "^3.2.0",
    "yaml": "^2.9.1"
  },
  "build": {
    "appId": "social.tgs.app",
    "productName": "TGS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "TGS"
    }
  }
}
